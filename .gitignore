# 依赖
node_modules/

# 构建产物
dist/
target/
release/
out/
*.asar

# 打包产物（本地产出，不进仓库）
client/*.app/
client/*.zip
client/*.dmg

# 系统与编辑器
.DS_Store
Thumbs.db
*.swp
*~

# 临时文件与运行时日志（bench-results/_attic 里的 .log 是实测证据，保留）
*.tmp
*.dl-*
npm-debug.log*
yarn-error.log*
*.server.log

# 压测快照：只留被压测报告引用过的那几个（bench-results / -final / -full-p4 /
# -m15-baseline / -m18）；无引用的残留快照不进仓库，新快照别顺手提交。
bench-results-full-p2/
bench-results-full-p8/
bench-results-m17/

# 助手/会话内部数据（不属于产品代码）
.workbuddy/

# 本地环境
.env
.env.*

# 便于离线转移的仓库包
*.bundle
