{
  "name": "b-artifact-client",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "b-artifact 客户端（工作副本 / 部分检出 / 锁 / 冲突解决）—— Tauri 2 + Rust",
  "scripts": {
    "typecheck": "tsc --noEmit && vue-tsc -p tsconfig.renderer.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "node scripts/build.mjs",
    "dev": "vite",
    "icon": "node scripts/make-icon.mjs",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "dist": "npm run build && npm run icon && tauri build",
    "dist:dir": "npm run build && npm run icon && tauri build --no-bundle"
  },
  "devDependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.5.0",
    "element-plus": "^2.14.5",
    "happy-dom": "^15.11.7",
    "pinia": "^2.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.21",
    "vitest": "^2.1.8",
    "vue": "^3.5.42",
    "vue-tsc": "^2.2.12"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4"
  },
  "author": "b-artifact"
}
