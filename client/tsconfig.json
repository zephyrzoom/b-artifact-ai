{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "noEmit": true
  },
  // 引擎与 CLI 已迁到 Rust（client/src-tauri）；这里只检查跨边界的 shared 与渲染层以外的 TS
  "include": ["src/shared/**/*.ts"],
  // 渲染层要 DOM lib 与 .vue 支持，单独用 tsconfig.renderer.json 检查
  "exclude": ["src/renderer", "tests/renderer", "dist", "src-tauri"]
}
